{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downpour",
  "version": "1.1.1",
  "identifier": "com.alikin4.downpour",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Downpour",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Ali Jabbary",
    "shortDescription": "A fast, modern download manager.",
    "longDescription": "Downpour is a fast, modern download manager: segmented transfers, reliable resume, batch capture and overnight scheduling.",
    "windows": {
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Downpour",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "publisher": "Ali Jabbary",
    "homepage": "https://github.com/ali-kin4/downpour"
  }
}
